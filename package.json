{
  "name": "buyguard",
  "version": "0.0.0",
  "private": true,
  "description": "Privacy-first marketplace listing risk analysis, rule-based first and local-first.",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
