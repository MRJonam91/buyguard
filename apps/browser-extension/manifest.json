{
  "manifest_version": 3,
  "name": "BuyGuard",
  "version": "0.1.0",
  "description": "Privacy-first browser extension for spotting misleading marketplace listings.",
  "permissions": ["activeTab", "sidePanel", "scripting"],
  "host_permissions": ["*://*.vinted.com/*", "*://*.vinted.it/*"],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.vinted.com/*", "*://*.vinted.it/*"],
      "js": ["src/content.ts"]
    }
  ],
  "action": {
    "default_title": "Open BuyGuard"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  }
}
